# Atlassian OAuth2 Configuration
# Get these from https://developer.atlassian.com/console/myapps/

# Jira OAuth2 App Credentials
JIRA_CLIENT_ID=your_jira_client_id_here
JIRA_CLIENT_SECRET=your_jira_client_secret_here

# Confluence OAuth2 App Credentials  
CONFLUENCE_CLIENT_ID=your_confluence_client_id_here
CONFLUENCE_CLIENT_SECRET=your_confluence_client_secret_here

# OAuth Redirect URI (must match registered redirect URI in Atlassian app)
OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# Application Security
SECRET_KEY=your_secret_key_here_change_in_production

# Atlassian API Configuration
ATLASSIAN_BASE_URL=https://api.atlassian.com

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
